{
  "name": "mahai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "pnpm build && vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "deploy:preprod": "cross-env CLOUDFLARE_ENV=preprod react-router build && wrangler deploy",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:preprod": "wrangler d1 migrations apply DB --remote --env preprod",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@fontsource-variable/lexend": "^5.2.8",
    "better-auth": "^1.7.27",
    "drizzle-orm": "^0.45.4",
    "isbot": "^5.1.36",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@react-router/dev": "^8.5.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.167.0"
  }
}
