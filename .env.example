# ==========================================
# Configuration Mah.AI - Copier vers .env.local
# ==========================================

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY="your-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Perplexity AI (pour les recherches web)
PERPLEXITY_API_KEY="your-perplexity-api-key"
PERPLEXITY_MODEL_FAST="llama-3.1-sonar-small-128k-chat"
PERPLEXITY_MODEL_STANDARD="llama-3.1-sonar-large-128k-chat"

# Claude API (pour les corrections IA)
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Resend (envoi d'emails)
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="noreply@mahai-edu.vercel.app"

# Vercel Blob Storage (stockage images)
BLOB_READ_WRITE_TOKEN="your-blob-token"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Environment
NODE_ENV="development"
PORT="3000"

# Optionnel: Logging
LOG_DB_QUERIES="false"
