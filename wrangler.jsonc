{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Worker qui sert l'app Next.js, construit par OpenNext (pnpm cf:build)
	"main": ".open-next/worker.js",
	"name": "mahai",
	"compatibility_date": "2026-10-20",
	// nodejs_compat : nécessaire pour pg, crypto, Buffer… côté serveur
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Auto-référence utilisée par le cache OpenNext ; doit porter le nom du worker
			"binding": "WORKER_SELF_REFERENCE",
			"service": "mahai"
		}
	],
	"r2_buckets": [
		{
			// Cache incrémental Next.js (ISR / fetch cache).
			// Créer le bucket avant le premier déploiement :
			//   pnpm wrangler r2 bucket create mahai-opennext-cache
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "mahai-opennext-cache"
		},
		{
			// Fichiers des utilisateurs : avatars, images de l'éditeur et du blog (lib/storage.ts).
			//   pnpm wrangler r2 bucket create mahai-assets
			"binding": "FILES",
			"bucket_name": "mahai-assets"
		}
	],
	"d1_databases": [
		{
			// Base principale (remplace Postgres en phase 3). Créer la base puis reporter son id ici :
			//   pnpm wrangler d1 create mahai
			"binding": "DB",
			"database_name": "mahai",
			"database_id": "00000000-0000-0000-0000-000000000000",
			// Migrations générées par drizzle-kit (pnpm db:generate)
			"migrations_dir": "drizzle"
		}
	],
	"images": {
		// Optimisation des images next/image via Cloudflare Images
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	}
}
